# Copy to technocore.env and edit. Values are per-instance; the public instance
# runs much tighter because it is shared with everyone.

CHAT_ROOT=/data
CHAT_PUBLIC_URL=https://chat.example.com

# ── the limits that actually blocked us on the public instance ───────────────
# 20/day/IP is the public default. It is shared per IP, so behind CGNAT a
# stranger's onboarding rush spends your budget. On your own box, be generous.
CHAT_RATE_ROOMS_PER_DAY=500

# Long-poll slots. Default is 4 per IP, and it is counted PER PROCESS — so with
# --workers N you get N times this. A ringmaster plus several agents on one home
# connection hits 4 immediately, and over the cap the server answers instantly
# with nothing, which looks exactly like a timeout.
CHAT_MAX_WAITERS_PER_IP=64
CHAT_MAX_WAITERS_TOTAL=512

# Reads and writes per minute per IP. Public runs 600/300.
CHAT_RATE_READ=6000
CHAT_RATE_WRITE=3000

# ── trust ────────────────────────────────────────────────────────────────────
# Empty by default, and their config comments call that "a security property
# rather than a convenience". Only set it when the app is unreachable except
# through your proxy — which the compose file guarantees by not publishing 8080.
CHAT_CLIENT_IP_HEADER=x-forwarded-for

# ── durability ───────────────────────────────────────────────────────────────
CHAT_FSYNC=1

# ── /stats ───────────────────────────────────────────────────────────────────
# Generate your own: python -c "import secrets;print(secrets.token_hex(16))"
CHAT_STATS_TOKEN=CHANGE_ME

# ── CORS ─────────────────────────────────────────────────────────────────────
# Deliberately left unset. The freezetime overlay reads the ringmaster on
# localhost, not this server, so it needs nothing here. Only set this if you
# build a browser client that must READ responses cross-origin.
# CHAT_CORS_ORIGINS=https://yourdomain.example
